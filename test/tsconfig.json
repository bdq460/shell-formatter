{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "types": [
            "jest",
            "node"
        ],
        "rootDir": "../",
        "outDir": "../dist-test",
        "noEmit": true,
        "paths": {
            "#/*": [
                "../src/*"
            ]
        }
    },
    "include": [
        "../src/**/*",
        "../test/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "dist-test",
        "coverage"
    ]
}
